// Prose rules for every Markdown file in the repository. The Docs workflow runs
// this on a change to any of them; `make docs` runs the same thing here.
{
  "globs": ["**/*.md"],
  // .claude/ holds scratch worktrees, which are checkouts of this repository:
  // without this the local run lints every page twice.
  "ignores": ["target/**", "_site/**", "node_modules/**", "web/editor/pkg/**", ".claude/**"],
  "config": {
    "default": true,

    // The house wraps prose near 90 columns rather than 80, and the ASCII
    // diagrams and tables run wider still. Reflowing them would buy nothing.
    "MD013": false,

    // Keep a Changelog repeats Added/Changed/Fixed under every release, which
    // is the format working as intended.
    "MD024": { "siblings_only": true },

    // The READMEs fold their longer sections into <details>.
    "MD033": { "allowed_elements": ["details", "summary"] },

    // Bold client names label the snippets under "Other MCP clients". They are
    // labels, not sections, and do not belong in a table of contents.
    "MD036": false,

    // Tables are written compact. Padding them to align is churn in every diff
    // that touches a row.
    "MD060": false
  }
}

/target
# Claude Code's local settings and scratch worktrees
.claude/
# Local secrets (Sentry DSN), read by the Makefile
.env.local
*.swp
.DS_Store
.idea/
.vscode/
*.profraw
__pycache__/

# Local projects and exports
*.sh3d
*.newera

# Built by `make web`
web/newera_web.wasm
web/editor/pkg/
web/*.newera
# except the home the browser editor opens on, which ships with the page
!web/demo.newera

# Built by `scripts/site-build.sh`, published to Cloudflare Pages
/_site

# Wrangler's local cache: account id and deploy state, nothing to version
.wrangler/

# Local secrets for the hosted service.
crates/newera-cloud/local/app.env

# The MCP relay for the browser editor, on the VPS.
#
# What it is: a small HTTP + WebSocket service that lets an AI reach the
# editor running in somebody's browser tab. It stores nothing — no project,
# no user, no rows — and everything it holds dies with the process. The
# Postgres this recipe provisions is therefore idle by design; it comes with
# the standard, and the standard is worth more than the 70 MB it costs.
APP_NAME=newera-relay
GITHUB_REPO=leandrodaf/3d-new-era-ai
HOSTNAME_PUBLICO=mcp.3dneweraai.com

# The port inside the container (the Dockerfile's EXPOSE) and the one it
# takes on 127.0.0.1. Nothing is published to the internet: the tunnel dials
# out, so the VPS opens no port at all.
APP_PORT=7979
HOST_PORT=7979

HEALTH_PATH=/health
LOG_TAG=relay

# It writes nothing to disk.
APP_DATA_DIR=

# It holds rooms in memory: a few kilobytes each, thousands at most.
APP_MEM=256m
PG_MEM=512m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE=384MB
PG_MAX_CONNECTIONS=20

# Nothing here is worth restoring, but the standard keeps the window open in
# case that ever changes. Away from the hours the other apps use.
R2_BUCKET=newera-relay-backups
BACKUP_HOUR=09

LOG_CAP_APP=536870912    # 512 MB
LOG_CAP_PG=268435456     # 256 MB

CRIAR_REPO=false

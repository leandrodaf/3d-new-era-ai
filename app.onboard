# The hosted 3D New Era AI (newera-cloud), on the VPS.
#
# What it is: the relay that lets an AI reach the editor in somebody's
# browser tab, plus accounts, OAuth for AI clients, one fixed MCP address and
# the editor with no window, which renders plans and photos on this machine.
# Accounts, plans and cloud projects live in the Postgres this recipe
# provisions — backed up daily to R2.
#
# The name stays newera-relay: it is the directory, the Postgres, the
# backups and the tunnel route that already exist, and renaming them would
# mean moving a live database for a label.
APP_NAME=newera-relay
GITHUB_REPO=leandrodaf/3d-new-era-ai
HOSTNAME_PUBLICO=mcp.3dneweraai.com

# The port inside the container (the Dockerfile's EXPOSE) and the one it
# takes on 127.0.0.1. Nothing is published to the internet: the tunnel dials
# out, so the VPS opens no port at all.
APP_PORT=7979
HOST_PORT=7979

# Healthy means the database answers (503 otherwise), so a deploy that
# cannot reach its data is rolled back.
HEALTH_PATH=/cloud/health
LOG_TAG=relay

# What it writes to disk is a cache (projects unpacked while they are
# worked on, top views): losing it on a new container costs nothing.
APP_DATA_DIR=

# Rooms are kilobytes; what weighs is a photo being path-traced, and every
# render — drafts included — runs in this container. 2 GB leaves room for a
# large plan at quality best; a ceiling, not a reservation. One and a half
# cores: the machine has two, and half a core stays for the other apps
# (Agendo Certo among them) whatever a render does.
APP_MEM=2g
APP_CPUS=1.5
PG_MEM=512m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE=384MB
PG_MAX_CONNECTIONS=20

# Accounts and projects: the daily backup is what they are restored from.
# Away from the hours the other apps use.
R2_BUCKET=newera-relay-backups
BACKUP_HOUR=09

LOG_CAP_APP=536870912    # 512 MB
LOG_CAP_PG=268435456     # 256 MB

CRIAR_REPO=false

# Optional secrets for the local compose: copy to app.env (git-ignored) to try
# real email or Google sign-in. Without it, sign-in links go to the log.

# Sign-in links by email (https://resend.com; the sender's domain verified there).
# Without it, email sign-in shows "not available yet" and the relay goes on working.
RESEND_API_KEY=
NEWERA_MAIL_FROM=3D New Era AI <entrar@3dneweraai.com>

# "Continue with Google" (an OAuth client of type Web application, redirect URI
# https://mcp.3dneweraai.com/login/google/callback). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults, shown for reference.
# NEWERA_PUBLIC_URL=https://mcp.3dneweraai.com
# NEWERA_SITE_ORIGINS=https://3dneweraai.com,https://www.3dneweraai.com

# The paid plan, sold through Paddle (merchant of record: it charges, handles
# the tax and pays out in dollars to Brazil). All four of the first block, or
# none (the paid plan off). In Paddle: Developer tools → Authentication for the
# client-side token and the API key; Notifications → a destination at
# https://mcp.3dneweraai.com/billing/paddle with the subscription.* events for
# the secret; Catalog → the Supporter product's two prices.
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# "Manage subscription", cancelling with a closed account, and finding who paid
# when a checkout carried no account. Optional; permissions: customers (read),
# customer portal sessions (write), subscriptions (write).
PADDLE_API_KEY=
# sandbox while trying it out with test keys; production otherwise (default).
# PADDLE_ENVIRONMENT=sandbox
